# Sao chép thành .env.local rồi điền. KHÔNG commit file .env.local.

# --- Bảo vệ endpoint /api/cron (bắt buộc, chuỗi ngẫu nhiên dài) ---
CRON_SECRET=

# --- Telegram (bắt buộc) ---
# Tạo bot qua @BotFather -> lấy token. Nhắn /start cho bot rồi mở: /api/cron?action=chat-id&secret=...
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Maps: chọn 1 trong 3 cách ---
# C (miễn phí, không cần key): đọc bằng trình duyệt Chrome thật qua Playwright. Đặt GOOGLE_SOURCE=browser
# Mỗi lần kiểm tra sẽ mở một cửa sổ Chrome ~15 giây. Chỉ chạy được trên máy/VPS có màn hình, không chạy trên Vercel.
GOOGLE_SOURCE=
GOOGLE_BROWSER_CHANNEL=chrome
# A (khuyến nghị, lấy được review mới nhất): SerpApi https://serpapi.com
SERPAPI_KEY=
GOOGLE_DATA_ID=0x313453afc2453f97:0xb2e39d46824e00e6
# B: Google Places API (New) - chỉ trả tối đa 5 review "liên quan nhất", có thể bỏ sót review mới
GOOGLE_API_KEY=
GOOGLE_PLACE_ID=ChIJlz9Fwq9TNDER5gBOgkad47I

# --- TripAdvisor Content API https://www.tripadvisor.com/developers ---
TRIPADVISOR_API_KEY=
TRIPADVISOR_LOCATION_ID=27950353
TRIPADVISOR_NAME=Vietlook Travel
# Review chỉ trả theo từng ngôn ngữ, liệt kê các ngôn ngữ cần theo dõi
TRIPADVISOR_LANGUAGES=en,vi
# Nếu key bị giới hạn theo domain, đặt domain đã đăng ký ở đây
TRIPADVISOR_REFERER=

# --- Lưu trạng thái (đã gửi review nào) ---
# Trên Vercel/serverless BẮT BUỘC dùng 1 trong 2: MongoDB Atlas, hoặc Upstash Redis (hoặc Vercel KV, KV_REST_API_*).
# Ưu tiên theo thứ tự: MongoDB > Redis > file. Chạy local/VPS có thể bỏ trống: lưu vào .data/state.json

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
